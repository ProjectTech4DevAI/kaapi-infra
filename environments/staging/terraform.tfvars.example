# staging specific values
project     = "kaapi"
environment = "staging"

# Account guard: Terraform refuses to run if AWS_PROFILE (from .env.staging) belongs to any other account.
aws_account_id = "REPLACE_WITH_STAGING_ACCOUNT_ID"

# ECS
ecs_container_insights = "disabled" # enabled | enhanced | disabled (enabled/enhanced add CloudWatch cost)

# ECR
ecr_repositories         = ["backend"] # one repo per service image; becomes kaapi-staging-backend
ecr_image_tag_mutability = "MUTABLE"   # MUTABLE | IMMUTABLE
ecr_max_image_count      = 10
